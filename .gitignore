# Session protocol
.session-log

# OS / IDE
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*~

# Python (if any tooling lives here)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env

# Logs and temp
*.log
*.tmp

# BIOS BINARIES (do not commit BY DEFAULT, with explicit exceptions)
# ----------------------------------------
# Most BIOS files in this repo would be either copyrighted Gigabyte
# originals or third-party community mods. We do not redistribute those.
# The project's own DIY-modded image is ALSO not committed: it is a
# derivative of Gigabyte's firmware and redistributing it is a decision
# that has not been made. There is deliberately NO re-include for it
# below. Only .gitkeep, README.md and *.notes.md are re-included, so the
# provenance notes and the SHA-256 are published while the binary is not.
bios/original/**
bios/modded/**
!bios/original/.gitkeep
!bios/original/README.md
!bios/original/**/*.notes.md
!bios/modded/.gitkeep
!bios/modded/README.md
!bios/modded/**/*.notes.md

# Common BIOS extensions and adjacent binaries, ANYWHERE in the repo.
# Defensive belt + suspenders: even if someone drops one outside bios/.
*.rom
*.bin
*.cap
*.fd
*.FD
*.iso
*.efi
# Gigabyte uses bare numeric / single-letter suffixes (e.g. *.FC, *.F1, *.F2g)
*.[Ff][0-9]
*.[Ff][0-9][a-zA-Z]
*.[Ff][0-9][0-9]
*.[Ff][0-9][0-9][a-zA-Z]
# AMI module files
*.ffs
# Archives that commonly contain BIOS payloads
*.rar
*.7z
*.zip
*.tar
*.tar.gz
*.tgz
# Tool binaries (Gigabyte Efiflash.exe, autoexec.bat, UEFITool.exe, etc.).
# We do not redistribute third-party tooling. Source URLs are documented
# in tools/README.md so each user downloads their own copy.
*.exe
*.bat
*.dll
*.sys
*.cmd
*.msi
*.com
# DOS/UEFI shell helpers that come bundled with Gigabyte BIOS downloads
Efiflash*
EFIFlash*
autoexec*
AUTOEXEC*

# AMI MMTool and UEFITool binaries (download yourself per their licensing
# terms; do not commit)
tools/MMTool*
tools/mmtool*
tools/UEFITool*
tools/uefitool*

# Explicit re-includes (must come AFTER all global *.FD / *.fd / etc rules)
# ----------------------------------------
# The DIY-modded deliverable (bios/modded/970AD3P2_NVME.FD) stays LOCAL for
# now: it is a modified Gigabyte image and redistribution rights are not yet
# settled. Its source BIOS, tool, module, SHA-256 and the wrong-board warnings
# are documented in bios/modded/970AD3P2_NVME.FD.notes.md. Re-include it here
# only after the licensing question is answered:
# !bios/modded/970AD3P2_NVME.FD
